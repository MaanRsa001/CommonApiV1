						<font fontName="Figtree-Light" size="8" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["Unoccupancy"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement positionType="Float" x="100" y="0" width="455" height="30" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true" uuid="4b9c2e35-89de-475d-9595-505e326c154e"/>
					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="Figtree-Light" size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["You must inform us if you intend on leaving your private home unoccupied for more than 60 consecutive days in any 12-month period. If you  do not inform us, it may result in claims being declined."]]></textFieldExpression>
				</textField>
			</frame>
			<frame>
