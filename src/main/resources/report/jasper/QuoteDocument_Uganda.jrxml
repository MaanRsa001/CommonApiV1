				</textElement>
				<textFieldExpression><![CDATA["Liability to Third parties"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="269" y="0" width="297" height="15" uuid="5f4c4e41-b0ec-40ef-8a9c-44c12794b005"/>
				<box topPadding="2" leftPadding="2" bottomPadding="2" rightPadding="2">
					<pen lineWidth="0.5"/>
				</box>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="9" isBold="false"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="0.0"/>
				</textElement>
				<textFieldExpression><![CDATA["Any accident caused by or through or in connection with any vehicle described in the schedule or in connection with loading and/or unloading of which the Insured and/or any passenger becomes legally liable to pay all sums including claimants' costs and expenses in respect of: \n (a)  Death of or Injury to any person (excluding employees or family   members). \n (b)  Damage to property other than property belonging to the Insured or in care, custody or control of Insured, or being conveyed by, loaded on to or unloaded from such vehicle "]]></textFieldExpression>
			</textField>
		</band>
