					<font fontName="Aptos" size="10"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0"/>
				</textElement>
				<textFieldExpression><![CDATA["Dear "+$F{customerName}+",\n\nWelcome to "+$F{companyName}+" family & we thank you for choosing our policy for your motor vehicle insurance. Your "+($F{policyNo}==null?"Quote No. "+$F{quoteNo}:"Policy No. "+$F{policyNo})+" has been issued based on the information and declaration provided by you. You are requested to visit our website "+($F{companyWebsite}==null?"-N-A":$F{companyWebsite})+" for full policy wordings"]]></textFieldExpression>
			</textField>
		</band>
