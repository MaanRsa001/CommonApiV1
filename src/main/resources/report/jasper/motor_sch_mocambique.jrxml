				<textElement verticalAlignment="Middle" rotation="None" markup="html">
					<font fontName="Verdana" size="6" isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["<b>Policy Servicing Office : </b>"+$F{companyAddress}+($F{companyPhone}==null?"":" | Tel No. "+$F{companyPhone})+($F{companyWebsite}==null?"":" | website : "+$F{companyWebsite})]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
