				<textElement textAlignment="Left" verticalAlignment="Middle" rotation="None">
					<font fontName="Aptos" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[("100048".equalsIgnoreCase($F{CompanyId})?"Our offices are open Monday to Friday, 08:00 – 17:00, and you can also contact us via email info@phoenixmozambique.com or through our website https://www.phoenixseguros.co.mz/.":"100046".equalsIgnoreCase($F{CompanyId})?"Our offices are open Monday to Friday, 08:00 – 17:00, and you can also contact us via email info@phoenixzambia.com or through our website https://www.phoenixzambia.com/":"100050".equalsIgnoreCase($F{CompanyId})?"Our offices are open Monday to Friday, 08:00 – 17:00, and you can also contact us via email info@phoenixassurancenamibia.com or through our website https://phoenixassurancenamibia.com/":"100049".equalsIgnoreCase($F{CompanyId})?"Our offices are open Monday to Friday, 08:00 – 17:00, and you can also contact us via email info@phoenixeswatini.com or through our website https://phoenixeswatini.com/":"Our offices are open Monday to Friday, 08:00 – 17:00, and you can also contact us via email underwriting1@phoenixbotswana.com or through our website https://www.phoenixbotswana.com/.")]]></textFieldExpression>
