				<textElement textAlignment="Justified" verticalAlignment="Top" rotation="None">
					<font fontName="Aptos" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["Welcome to the "+$F{CompanyName}+" family! We’re delighted that you’ve chosen us to take care of your insurance needs — and we look forward to providing you with the trusted protection and exceptional service you deserve."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" mode="Transparent" x="0" y="184" width="539" height="56" isPrintWhenDetailOverflows="true" backcolor="#E8E8E8" uuid="c27f7afd-81c6-456c-a9fa-2d9510ca18f4">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
