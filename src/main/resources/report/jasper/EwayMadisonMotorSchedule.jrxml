				<reportElement x="0" y="168" width="286" height="42" isPrintWhenDetailOverflows="true" uuid="63ff4c17-e8d5-4340-8ec8-2fff05192a13">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement verticalAlignment="Middle" markup="html">
					<font fontName="Verdana" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["(i) Bodily injury or death per person K 66,700.00<br/> (ii) Bodily injury or death per event K 133,400.00<br/>"+(!Arrays.asList("actonly").contains($F{sectionName}.toLowerCase().replace(" ",""))?" (iii) Property Damage K 30,100.00<br/> ":"")+"(Unless otherwise stated, standard statutory limits apply)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="228" width="286" height="75" isPrintWhenDetailOverflows="true" uuid="c3054739-eeaa-4e73-8239-d15e3607ea3a">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement verticalAlignment="Middle" markup="html">
					<font fontName="Verdana" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["In the event of  a collision, when the driver of Third Party vehicle is found at fault, the injured will take all reasonable steps to collect Third Party vehicle details such as <br/>(i) Vehicle Owner's name and address <br/>(ii) drivers name <br/>(iii) Insurance Company name <br/> (iv) Cover Note/ Policy Number, to meet the cost of repairs and other claims before repairs and other claims to the insured's vehicle are authorised."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="321" width="286" height="15" isPrintWhenDetailOverflows="true" uuid="0b58fc8a-b0d3-4249-ba5b-2019f3159e1c">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement verticalAlignment="Middle" markup="html">
					<font fontName="Verdana" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["15% of each and every claim subject to a minimum of K1000"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="387" width="320" height="32" isPrintWhenDetailOverflows="true" uuid="c88b8a12-a242-4dbf-bf2f-b0aad7ec58ed">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement markup="html">
					<font fontName="Verdana" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Document is issued in accordance with the provisions of Part IX of the Roads and Road Traffic Act of the Republic of Zambia. Full document can be downloaded from www.phoenixzambia.com if required."]]></textFieldExpression>
			</textField>
