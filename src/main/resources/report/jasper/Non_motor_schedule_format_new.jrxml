					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="verdana" size="5.5"/>
					</textElement>
					<textFieldExpression><![CDATA["Unoccupancy"]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="100" y="0" width="455" height="30" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true" uuid="39cfa2e4-e112-4340-ac30-c302cd10939e"/>
					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="verdana" size="5.5" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["You must inform us if you intend on leaving your private home unoccupied for more than 60 consecutive days in any 12-month period. If you  do not inform us, it may result in claims being declined."]]></textFieldExpression>
				</textField>
			</frame>
			<frame>
				<reportElement positionType="Float" x="0" y="48" width="555" height="30" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true" uuid="5dde3b7e-0d7c-4362-adad-2ee605aca79d"/>
